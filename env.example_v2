# Sisyphus' Daily Data — copy this to .env and fill in your values

DISCORD_TOKEN=your_discord_bot_token_here
OPGG_MCP_URL=https://mcp-api.op.gg/mcp
OPGG_REGION=SEA
BACKFILL_DAYS=3
THREAD_ID=your_discord_thread_id
CHANNEL_ID=your_discord_channel_id
GUILD_ID=your_discord_guild_id
# Comma-separated list of Discord user IDs allowed to run admin commands
ADMIN_IDS=your_discord_user_id
DEVELOPER_DISCORD_ID=your_discord_user_id
MARKET_ROLE_ID=your_discord_role_id
BETTING_ENABLED=true
APP_VERSION=2.1.10
TELEGRAM_POLLING_ENABLED=false
RIOT_KEY_DAILY_REMINDER_ENABLED=false

# Public Uptime Kuma status page. Keep disabled until all push URLs are set.
STATUS_PAGE_ENABLED=false
STATUS_PAGE_URL=https://your-status-host/status/sisyphus
STATUS_HEALTH_MAX_AGE_SECONDS=180
UPTIME_KUMA_BOT_PUSH_URL=
UPTIME_KUMA_DISCORD_PUSH_URL=
UPTIME_KUMA_POLLING_PUSH_URL=
UPTIME_KUMA_RIOT_PUSH_URL=
UPTIME_KUMA_OPGG_PUSH_URL=
UPTIME_KUMA_MARKETS_PUSH_URL=

# Authenticated analytics dashboard. Keep export/upload disabled until the
# Oracle service and OAuth callback are configured.
DASHBOARD_URL=https://sisyphus.burntdosa.site
DASHBOARD_EXPORT_ENABLED=false
DASHBOARD_EXPORT_SECRET=replace_with_a_long_random_hmac_secret
# Optional dedicated HMAC value. When set, install the same value privately on
# Oracle so the dashboard can select the signed-in member's tracked profile.
DASHBOARD_MEMBER_KEY_SECRET=
DASHBOARD_SSH_TARGET=dashboard_user@your_dashboard_host
DASHBOARD_SSH_KEY=/absolute/path/to/dashboard-ssh-key
DASHBOARD_REMOTE_PATH=/opt/sisyphus-dashboard/data/export.json
DASHBOARD_EXPORT_INTERVAL_SECONDS=300
# Discord OAuth settings and DASHBOARD_SESSION_SECRET belong only in the private
# Oracle dashboard .env; do not put them in this Mac bot environment.
# Required only when running the Oracle dashboard deploy helper.
CERTBOT_EMAIL=your_email_for_certificate_renewal

# Riot Games API Config
RIOT_KEY=your_riot_developer_key_here
# Optional ISO timestamp used by scripts/automation/riot-key-auto-renew.py.
RIOT_KEY_EXPIRES_AT=2026-07-04T00:04:00-07:00
PLATFORM=sg2
# Optional comma-separated platform probes for live-game detection.
# This server uses SG only.
RIOT_PLATFORMS=sg2
REGION=sea

# Telegram Bot Config
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
